# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings > API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to create staff accounts from /admin/users and for
# privileged CMS writes. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
